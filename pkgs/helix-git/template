# Template file for 'helix-git'
pkgname=helix-git
version=20260522
revision=1

_commit="a62d374fcb489f83bddd3a775df250ff4b9b34a9"

build_style=cargo
make_build_args="-p helix-term"

hostmakedepends="
 cargo
 git
 pkg-config
"

depends="git"

short_desc="Post-modern modal text editor (latest git master)"
maintainer="Sunny <you@example.com>"
license="MPL-2.0"
homepage="https://helix-editor.com"

distfiles="https://github.com/helix-editor/helix/archive/${_commit}.tar.gz"
checksum="2c7151812ea80e15fb3219b3ea3a6485ae8844996ce408d294999def428c0cbf"

conflicts="helix>=0"

do_install() {
	vbin target/${RUST_TARGET}/release/hx

	vmkdir usr/lib/helix
	cp -r runtime ${DESTDIR}/usr/lib/helix/

	# Remove grammar source trees — they're huge and not needed at runtime
	rm -rf ${DESTDIR}/usr/lib/helix/runtime/grammars/sources

	# Remove any leftover build artifacts
	find ${DESTDIR}/usr/lib/helix/runtime/grammars \
		-type f -name "a.out" -delete

	vlicense LICENSE
	vdoc README.md
}
