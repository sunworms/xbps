pkgname=helium-browser-bin
# version and checksum are managed automatically by .github/workflows/update-helium.yml
# DO NOT edit these lines manually
version=0.12.3.1
revision=1
short_desc="Private, fast, and honest web browser based on Chromium (binary)"
maintainer="Your Name <you@example.com>"
license="BSD-3-Clause"
homepage="https://github.com/imputnet/helium"
distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
checksum="6b891cb9d37e6ec395db9dc14a64c5b31d139e09abfe36d477f03581eb1ce901"

only_for_archs="x86_64"
depends="glib dbus gtk+3 nss libXcomposite libXdamage libXrandr libXScrnSaver alsa-lib libcups"
hostmakedepends="tar xz"
conflicts="helium>=0"

do_extract() {
	mkdir -p ${wrksrc}
	tar xf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/helium-${version}-x86_64_linux.tar.xz \
		-C ${wrksrc} --strip-components=1
}

do_install() {
	vmkdir usr/lib/helium-browser
	vcopy . usr/lib/helium-browser

	vmkdir usr/bin
	cat > ${DESTDIR}/usr/bin/helium-browser <<-'WRAPPER'
		#!/bin/sh
		FLAGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/helium-flags.conf"
		SYS_FLAGS_FILE="/etc/helium/helium-flags.conf"
		flags=""
		for f in "$SYS_FLAGS_FILE" "$FLAGS_FILE"; do
			[ -f "$f" ] || continue
			while IFS= read -r line; do
				case "$line" in "#"*|"") continue ;; esac
				flags="$flags $line"
			done < "$f"
		done
		exec /usr/lib/helium-browser/chrome $flags "$@"
	WRAPPER
	chmod 0755 ${DESTDIR}/usr/bin/helium-browser

	if [ -f ${wrksrc}/helium.desktop ]; then
		sed -i \
			-e 's|Exec=chromium|Exec=helium-browser|' \
			-e 's|Name=Helium$|Name=Helium Browser|' \
			-e 's|Icon=helium|Icon=helium-browser|' \
			${wrksrc}/helium.desktop
		vinstall ${wrksrc}/helium.desktop 644 usr/share/applications helium-browser.desktop
	fi

	for size in 24 48 64 128 256; do
		icon="${wrksrc}/product_logo_${size}.png"
		[ -f "$icon" ] || continue
		vmkdir usr/share/icons/hicolor/${size}x${size}/apps
		vinstall "$icon" 644 usr/share/icons/hicolor/${size}x${size}/apps helium-browser.png
	done

	vmkdir etc/helium
	cat > ${DESTDIR}/etc/helium/helium-flags.conf <<-'CONF'
		# System-wide Helium Browser flags — one per line
		# --enable-features=UseOzonePlatform
		# --ozone-platform=wayland
	CONF
}
